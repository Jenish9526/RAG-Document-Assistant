.coverage
htmlcov/
.tox/

# Streamlit runtime cache
.streamlit/

# Persistent data generated at runtime (indices & raw uploads)
data/vectorstore/*
data/raw/*
data/processed/*

# IDE and OS files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
