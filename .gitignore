# Environment variables & secrets (keep private)
.env
.env.local
*.env

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing & coverage artifacts
