# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub.

# API key for your chosen LLM provider.
# For Google Gemini, get a free API key at: https://aistudio.google.com/app/apikey
LLM_API_KEY=your_api_key_here

# OpenAI-compatible base URL for the LLM provider.
# Default below points to Google Gemini (1,000,000 TPM free tier, OpenAI-compatible).
# Examples for other providers:
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/ (model: gemini-3.6-flash)
#   Groq:          https://api.groq.com/openai/v1                   (model: openai/gpt-oss-20b)
#   OpenAI:        https://api.openai.com/v1                        (model: gpt-4o-mini)
#   Ollama (local):http://localhost:11434/v1                        (model: llama3.2)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model name to use with the provider above.
LLM_MODEL=gemini-3.6-flash
